{
  "log": { "loglevel": "none" },
{% if xray_dns_profile != 'disabled' %}
  "dns": {
    "servers": [
      {
        "address": "unbound",
        "port": 5353,
        "finalQuery": true,
        "skipFallback": true,
        "queryStrategy": "UseIPv4",
        "tag": "dns-out"
      }
    ],
    "queryStrategy": "UseIPv4",
    "disableFallback": true
  },
{% endif %}
  "inbounds": [
    {
      "port": {{ xray_state.vision_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% for key in xray_state.access_keys %}
          {"id": "{{ key.vision_uuid }}", "email": "{{ key.key_id }}", "flow": "xtls-rprx-vision"}{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "target": "{{ xray_server_name }}:443",
          "serverNames": ["{{ xray_server_name }}"],
          "privateKey": "{{ xray_state.reality_private_key }}",
          "shortIds": ["{{ xray_state.reality_short_id }}"]
        }
      }
    },
    {
      "port": {{ xray_state.xhttp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% for key in xray_state.access_keys %}
          {"id": "{{ key.xhttp_uuid }}", "email": "{{ key.key_id }}"}{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "{{ xray_xhttp_path }}",
          "mode": "packet-up",
          "extra": {
            "scMaxEachPostBytes": 1000000,
            "scMaxBufferedPosts": 30
          }
        },
        "security": "reality",
        "realitySettings": {
          "target": "{{ xray_server_name }}:443",
          "serverNames": ["{{ xray_server_name }}"],
          "privateKey": "{{ xray_state.reality_private_key }}",
          "shortIds": ["{{ xray_state.reality_short_id }}"]
        }
      }
    }
  ],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct"}
{% if xray_dns_profile != 'disabled' %}
    ,{"protocol": "blackhole", "tag": "block"}
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {"type": "field", "inboundTag": ["dns-out"], "outboundTag": "direct"},
      {"type": "field", "network": "tcp,udp", "port": "53,853", "outboundTag": "block"}
    ]
  }
{% else %}
  ]
{% endif %}
}
