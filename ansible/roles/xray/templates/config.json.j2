{% set has_local_region = xray_local_region_countries | length > 0 %}
{
  "log": { "loglevel": "none" },
{% if xray_dns_profile != 'disabled' %}
  "dns": {
    "servers": [
      {
        "address": "{{ xray_unbound_ipv4 }}",
        "port": 5353,
        "finalQuery": true,
        "skipFallback": true,
        "queryStrategy": "UseIPv4",
        "tag": "dns-out"
      }
    ],
    "queryStrategy": "UseIPv4",
    "disableFallback": true
  },
{% endif %}
  "inbounds": [
    {
      "port": {{ xray_state.vision_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% for key in xray_state.access_keys %}
          {"id": "{{ key.vision_uuid }}", "email": "{{ key.key_id }}", "flow": "xtls-rprx-vision"}{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "target": "{{ xray_server_name }}:443",
          "serverNames": ["{{ xray_server_name }}"],
          "privateKey": "{{ xray_state.reality_private_key }}",
          "shortIds": ["{{ xray_state.reality_short_id }}"]
        }
      }
    },
    {
      "port": {{ xray_state.xhttp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% for key in xray_state.access_keys %}
          {"id": "{{ key.xhttp_uuid }}", "email": "{{ key.key_id }}"}{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "{{ xray_xhttp_path }}",
          "mode": "packet-up",
          "extra": {
            "scMaxEachPostBytes": 1000000,
            "scMaxBufferedPosts": 30
          }
        },
        "security": "reality",
        "realitySettings": {
          "target": "{{ xray_server_name }}:443",
          "serverNames": ["{{ xray_server_name }}"],
          "privateKey": "{{ xray_state.reality_private_key }}",
          "shortIds": ["{{ xray_state.reality_short_id }}"]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "{% if xray_dns_profile != 'disabled' %}ForceIPv4{% else %}UseIPv4{% endif %}"
      },
      "tag": "direct"
    }
{% if xray_dns_profile != 'disabled' or has_local_region %}
    ,{"protocol": "blackhole", "tag": "block"}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
{% if xray_dns_profile != 'disabled' %}
      {"type": "field", "inboundTag": ["dns-out"], "outboundTag": "direct"},
{% endif %}
{% if has_local_region %}
{% if 'ru' in xray_local_region_countries %}
      {"type": "field", "domain": ["domain:ru", "domain:рф", "domain:xn--p1ai"], "outboundTag": "block"},
{% endif %}
      {"type": "field", "ip": [{% for country in xray_local_region_countries %}"geoip:{{ country }}"{% if not loop.last %}, {% endif %}{% endfor %}], "outboundTag": "block"}{% if xray_dns_profile != 'disabled' %},{% endif %}
{% endif %}
{% if xray_dns_profile != 'disabled' %}
      {"type": "field", "network": "tcp,udp", "port": "53,853", "outboundTag": "block"}
{% endif %}
    ]
  }
{% else %}
  ]
{% endif %}
}
